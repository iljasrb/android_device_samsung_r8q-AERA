+  // Mask the vendor flash_recovery service directly; the reboot hook also
+  // retries this and falls back to the boot cmdline guard if needed.
+  Disable_Vendor_Flash_Recovery_Service();
+}
+
+// Android init parses /system/etc/init before /vendor/etc/init. Defining the
+// vendor's flash_recovery service first makes the vendor definition a duplicate
+// that init ignores. A disabled dummy service therefore stops the recovery
+// overwrite without touching the boot image or the read-only erofs vendor.
+bool TWFunc::Disable_Vendor_Flash_Recovery_Service(void)
+{
+  LOGINFO("AERA vendor flash_recovery: check (dont=%d advanced=%d force=%d)\n",
+          DataManager::GetIntValue(AERA_DONT_REPLACE_STOCK),
+          DataManager::GetIntValue(AERA_ADVANCED_STOCK_REPLACE),
+          Aera_Force_Deactivate_Process);
+  if (DataManager::GetIntValue(AERA_DONT_REPLACE_STOCK) == 1)
+    return false;
+  // Vanilla builds leave AERA_ADVANCED_STOCK_REPLACE at 0; keep AERA unless
+  // the user explicitly requested stock recovery.
+
+  // Do not probe /vendor here: AOSPA's vendor is erofs and the recovery's
+  // /vendor fstab entry may not mount it. The dummy is harmless when the ROM
+  // has no vendor_flash_recovery service, and prevents the service when it
+  // does.
+  std::string block;
+  TWPartition *system = PartitionManager.Find_Partition_By_Path("/system");
+  if (system != NULL && !system->Actual_Block_Device.empty())
+    block = system->Actual_Block_Device;
+  if (block.empty())
+    {
+      const char *candidates[] = {
+          "/dev/block/mapper/system",
+          "/dev/block/by-name/system",
+          "/dev/block/bootdevice/by-name/system"};
+      for (const char *candidate : candidates)
+        if (Path_Exists(candidate))
+          {
+            block = candidate;
+            break;
+          }
+    }
+  if (block.empty())
+    {
+      LOGINFO("AERA vendor flash_recovery: system block device not found\n");
+      return false;
+    }
+
+  PartitionManager.UnMount_By_Path(PartitionManager.Get_Android_Root_Path(), false);
+  PartitionManager.UnMount_By_Path("/system", false);
+
+  const char *mount_point = "/mnt/aera-system-rw";
+  mkdir(mount_point, 0755);
+  if (mount(block.c_str(), mount_point, "ext4", 0, "") != 0)
+    {
+      LOGINFO("AERA vendor flash_recovery: cannot mount %s rw: %s\n",
+              block.c_str(), strerror(errno));
+      return false;
+    }
+
+  std::string root = mount_point;
+  if (Path_Exists(root + "/system/etc/init"))
+    root += "/system";
+  const std::string init_dir = root + "/etc/init";
+  static const char override_text[] =
+      "\nservice vendor_flash_recovery /system/bin/true\n"
+      "    class core\n"
+      "    user root\n"
+      "    oneshot\n"
+      "    disabled\n";
+
+  bool masked = false;
+  DIR *dir = opendir(init_dir.c_str());
+  if (dir != NULL)
+    {
+      std::vector<std::string> files;
+      struct dirent *entry;
+      while ((entry = readdir(dir)) != NULL)
+        {
+          std::string name(entry->d_name);
+          if (name.size() > 3 && name.compare(name.size() - 3, 3, ".rc") == 0)
+            files.push_back(init_dir + "/" + name);
+        }
+      closedir(dir);
+      std::sort(files.begin(), files.end());
+
+      for (const auto &file : files)
+        {
+          std::string data;
+          if (read_file(file, data) != 0)
+            continue;
+          if (data.find("service vendor_flash_recovery") != std::string::npos)
+            {
+              masked = true;
+              break;
+            }
+          struct stat st;
+          if (stat(file.c_str(), &st) != 0 || !S_ISREG(st.st_mode))
+            continue;
+          const long long slack = (long long)st.st_blocks * 512 - (long long)st.st_size;
+          if (slack < (long long)sizeof(override_text))
+            continue;
+          int fd = open(file.c_str(), O_WRONLY | O_APPEND | O_CLOEXEC);
+          if (fd < 0)
+            continue;
+          const ssize_t written = write(fd, override_text, sizeof(override_text) - 1);
+          fsync(fd);
+          close(fd);
+          if (written == (ssize_t)(sizeof(override_text) - 1))
+            {
+              LOGINFO("AERA vendor flash_recovery: masked service in %s\n", file.c_str());
+              masked = true;
+              break;
+            }
+        }
+    }
+
+  if (!masked)
+    {
+      const std::string file = init_dir + "/zz_aera_disable_vendor_flash_recovery.rc";
+      int fd = open(file.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+      if (fd >= 0)
+        {
+          const ssize_t written = write(fd, override_text + 1, sizeof(override_text) - 2);
+          fsync(fd);
+          close(fd);
+          if (written == (ssize_t)(sizeof(override_text) - 2))
+            {
+              LOGINFO("AERA vendor flash_recovery: created %s\n", file.c_str());
+              masked = true;
+            }
+        }
+    }
+
+  sync();
+  umount(mount_point);
+  if (!masked)
+    LOGINFO("AERA vendor flash_recovery: no system init slot was available\n");
+  return masked;
 }
 
