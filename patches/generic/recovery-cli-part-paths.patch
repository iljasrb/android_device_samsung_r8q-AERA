+// The CLI accepts partition names ("boot") as well as volume paths ("/boot").
+// Normalize to the paths RecoveryRunJobImpl compares against, so a bare name
+// works instead of producing the unhelpful "could not create" error.
+std::vector<std::string> PartitionPaths(const Json::Value &args) {
+  std::vector<std::string> result = Strings(args, "parts");
+  for (auto &path : result)
+    if (path[0] != '/') path.insert(path.begin(), '/');
+  return result;
+}
